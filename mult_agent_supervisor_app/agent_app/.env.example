# Make a copy of this to set environment variables for local development
# cp .env.example .env

# TODO: Fill in auth related env vars
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-here>.databricks.com
# DATABRICKS_TOKEN=dapi....

# Org id (?o=) used to build the Genie embed URLs shown in the app's "Agents"
# tab. Find it in any workspace URL (…?o=<org-id>). In Databricks Apps,
# DATABRICKS_HOST is injected automatically; set it above for local dev.
# Optional for single-workspace hosts.
# DATABRICKS_ORG_ID=

# TODO: Update with the MLflow experiment you want to log traces and models to
MLFLOW_EXPERIMENT_ID=

# Manuals retrieval resources
GENIE_SPACE_ID=
# Genie spaces exposed as orchestrator tools AND in the "Agents" tab (iframes).
# JSON array of {id, name, label?, description}. `name` is the snake_case tool
# name ([a-zA-Z0-9_-]+); `label` is the optional pretty display name; both the
# model and the Agents-tab card use `description`. GENIE_AGENT_IDS (comma-
# separated ids) is a simpler fallback.
# GENIE_AGENTS=[{"id":"<space-id>","name":"my_genie","label":"My Genie","description":"What this Genie answers."}]
VECTOR_SEARCH_INDEX=<catalog>.<schema>.<index_name>

# Lakebase-backed short-term conversation memory.
# Prefer the full Autoscaling endpoint resource path:
# projects/<project>/branches/<branch>/endpoints/<endpoint>
LAKEBASE_AUTOSCALING_ENDPOINT=
LAKEBASE_AGENT_MEMORY_SCHEMA=agent_openai_memory

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
# IMPORTANT: For local development, use databricks (for default profile) or databricks://<profile-name> to specify which Databricks CLI profile to use
# This is automatically configured by the quickstart script
MLFLOW_TRACKING_URI="databricks"
MLFLOW_REGISTRY_URI="databricks-uc"
